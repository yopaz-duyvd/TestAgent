{
  "language": "csharp",
  "framework": ".NET 8",
  "architecture": "layered",
  "projectType": "webapi",
  "entryProject": "Hackathon/Hackathon",
  "projects": [
    "Hackathon/Hackathon"
  ],
  "layers": {
    "presentation": "Controllers",
    "application": "Services",
    "data": "Repositories",
    "domain": "Models",
    "infrastructure": "UnitOfWork"
  },
  "features": {
    "useDatabase": true,
    "databaseType": "mysql",
    "useEfCore": true,
    "useAuthentication": true,
    "authenticationType": "jwt",
    "useDependencyInjection": true,
    "useUnitOfWork": true,
    "autoAddNugetPackages": true,
    "autoUpdateCsproj": true
  },
  "rules": {
    "ensureProjectsAddedToSolution": true,
    "respectArchitectureLayers": true,
    "useEfCoreInsteadOfInMemory": true,
    "enforceDependencyFlow": true,
    "controllerShouldNotAccessRepositoryDirectly": true,
    "serviceShouldNotDependOnPresentation": true,
    "avoidDirectDbContextAccessInController": true
  }
}
